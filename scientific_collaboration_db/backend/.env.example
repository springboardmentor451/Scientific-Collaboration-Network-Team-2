# Copy this file to .env and adjust values as needed

POSTGRES_USER=scan_user
POSTGRES_PASSWORD=scan_password
POSTGRES_DB=scientific_collab_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string used by the app (built automatically if left blank)
DATABASE_URL=postgresql+psycopg2://scan_user:scan_password@localhost:5432/scientific_collab_db

# App
APP_ENV=development
SECRET_KEY=change-this-secret-key-in-production
API_BASE_URL=http://localhost:8000

# Email (SMTP) — used to send real verification emails.
# Leave SMTP_USERNAME/SMTP_PASSWORD blank to run in "dev mode": verification
# links are logged to the console instead of emailed, so you can still test
# without a real mail account.
#
# To use a real Gmail account:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#   3. Use that 16-character App Password below (NOT your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Scientific Collaboration Network Analyzer

GOOGLE_CLIENT_ID=